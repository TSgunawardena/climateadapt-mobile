{
  "expo": {
    "name": "ClimateAdapt",
    "slug": "climateadapt-prototype",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/climateadapt-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
  "icon": "./assets/climateadapt-icon.png",
  "predictiveBackGestureEnabled": false,
      "package": "nz.climateadapt.prototype",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for local privacy checking and observation analysis.",
          "cameraPermission": "Take an observation photo for the ClimateAdapt prototype.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Attach your current location to an observation only when you choose to."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-status-bar"
    ],
    "description": "Outdoor photo observations with local privacy masking and separate location susceptibility screening. Preliminary results require human review.",
    "extra": {
      "eas": {
        "projectId": "a7f7cdc5-f5aa-48f9-b73b-ed82f1fb978a"
      }
    }
  }
}
